---
import Equation from './Equation.astro';
---
<div class="simulator" data-simulator><form class="sim-controls" aria-label="飛行条件"><div class="sim-panel-heading"><span class="eyebrow">01 / INPUT</span><h2>キックの条件</h2></div>{[
 {id:'speed',label:'初速度',unit:'m/s',min:0,max:40,step:0.5,value:25,help:'0〜40 m/s（1 m/s = 3.6 km/h）'},
 {id:'angle',label:'打ち出し角度',unit:'°',min:0,max:90,step:1,value:40,help:'水平を0°、真上を90°とします。'},
 {id:'height',label:'打ち出し高さ',unit:'m',min:0,max:2,step:0.1,value:0,help:'着地時のボール中心を0 mとした相対高さ。'}
].map(c=><div class="control"><div class="control-top"><label for={c.id}>{c.label}</label><div class="number-wrap"><input id={c.id} name={c.id} type="number" min={c.min} max={c.max} step={c.step} value={c.value} required aria-describedby={`${c.id}-help`}/><span>{c.unit}</span></div></div><input id={`${c.id}-slider`} aria-label={`${c.label}のスライダー`} type="range" min={c.min} max={c.max} step={c.step} value={c.value} aria-describedby={`${c.id}-help`}/><small id={`${c.id}-help`}>{c.help}</small></div>)}<button class="reset-button" type="reset">初期値に戻す ↺</button><p class="sim-model">MODEL 01<br/><strong>空気抵抗なし・重力一定</strong></p><p id="input-error" role="alert" class="input-error"></p></form><section class="sim-results" aria-label="計算結果"><div class="sim-panel-heading"><span class="eyebrow">02 / OBSERVE</span><span class="model-pill">理論値</span></div><div class="metric-grid" aria-live="polite" aria-atomic="true"><div><span>飛距離</span><strong><output id="range-value">62.74</output><small>m</small></strong></div><div><span>最高到達点</span><strong><output id="peak-value">13.16</output><small>m</small></strong></div><div><span>滞空時間</span><strong><output id="time-value">3.28</output><small>s</small></strong></div></div><div id="flight-plot" role="img" aria-label="飛行軌道。横軸は水平距離m、縦軸は着地面からの相対高さm。数値は下の表でも確認できます。" aria-describedby="plot-summary"></div><p id="plot-summary" class="plot-summary"></p><p id="plot-status" role="status"></p><details class="data-details"><summary>軌道データを表で確認</summary><div class="table-scroll" tabindex="0" role="region" aria-label="数値の表。横にスクロールできます"><table><caption>飛行軌道の代表点（最終行は着地）</caption><thead><tr><th scope="col">時刻 / s</th><th scope="col">水平距離 / m</th><th scope="col">相対高さ / m</th></tr></thead><tbody id="trajectory-data"></tbody></table></div></details><noscript><p class="notice">条件の操作にはJavaScriptが必要です。下の理論式と講座はJavaScriptなしでも読めます。</p></noscript></section></div>
<details class="sim-formulas"><summary>計算に使う理論式と記号</summary><Equation tex={String.raw`T=\frac{v_0\sin\theta+\sqrt{(v_0\sin\theta)^2+2gh}}{g},\quad R=v_0\cos\theta\,T`} symbols="T：滞空時間 [s]、R：飛距離 [m]、v₀：初速度 [m/s]、θ：水平からの角度 [rad、画面は度]、h：打ち出し相対高さ [m]、g：重力加速度 9.81 [m/s²]" conditions="質点・空気抵抗と揚力なし・一定重力・平らな着地面。v₀≥0、0≤θ≤90°、h≥0。最初に下降して着地面へ達する時刻を採用。地面上の水平発射などは滞空0。"/><Equation tex={String.raw`H=h+\frac{(v_0\sin\theta)^2}{2g},\quad x(t)=v_0\cos\theta\,t,\quad y(t)=h+v_0\sin\theta\,t-\frac12gt^2`} symbols="H：最高到達点 [m]、x：水平距離 [m]、y：相対高さ [m]、t：時刻 [s]、他の記号は直上と共通" conditions="直上の無抵抗モデル、上向きまたは水平発射。放出から着地まで。最高点は着地時のボール中心を基準。"/></details>
<script>import '../scripts/simulator';</script>

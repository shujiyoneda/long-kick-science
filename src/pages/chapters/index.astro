---
import Base from '../../layouts/Base.astro';import LessonCard from '../../components/LessonCard.astro';import {chapters,lessons,publishedLessons,publishedChapters} from '../../data/curriculum';import {url} from '../../lib/paths';
---
<Base title="全8章・24講座"><section class="page-intro container"><span class="eyebrow">THE LEARNING MAP</span><h1>一蹴りを、解き明かそう。</h1><p>全8章・24講座。高校物理から、大学レベルの解析へ。</p><div class="notice"><strong>公開状況：{publishedLessons.length} / {lessons.length}講座</strong><p>Chapter {publishedChapters.map(c=>c.id).join('・')}の本文を公開しています。他の{lessons.length-publishedLessons.length}講座では、学習目標と詳細アウトラインを閲覧できます。</p></div></section><div class="container course-map">{chapters.map(c=><section class="chapter-section"><div class="chapter-intro"><span class="chapter-number">{c.id}</span><div><span class="eyebrow">{c.label}</span><h2><a href={url(`chapters/${c.id}/`)}>{c.title} <span>↗</span></a></h2><p>{c.description}</p></div></div><div class="lesson-grid">{c.lessons.map(l=><LessonCard lesson={l}/>)}</div></section>)}</div></Base>

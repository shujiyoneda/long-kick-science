---
import Base from '../../layouts/Base.astro';import {chapters,lessons,sectionNames,sectionIds} from '../../data/curriculum';import {url} from '../../lib/paths';
export function getStaticPaths(){return lessons.map(lesson=>({params:{id:lesson.id},props:{lesson}}));}
const {lesson:l}=Astro.props;const chapter=chapters[l.chapter-1];
const articles=import.meta.glob<{default:any}>('../../content/lessons/*.mdx',{eager:true});
const Article=articles[`../../content/lessons/${l.id}.mdx`]?.default;
const index=lessons.findIndex(x=>x.id===l.id),prev=lessons[index-1],next=lessons[index+1];
---
<Base title={l.title} description={l.goal}><header class="article-header container"><nav class="breadcrumbs" aria-label="パンくず"><a href={url('chapters/')}>講座一覧</a><span>/</span><a href={url(`chapters/${chapter.id}/`)}>Chapter {chapter.id}</a><span>/</span><span>{l.level}</span></nav><div class="article-meta"><span class="eyebrow">LESSON {l.id} · {l.level}</span><span class:list={['status',{live:l.status==='published'}]}>{l.status==='published'?'公開中':'本文未公開'}</span>{l.status==='published' && <span>約{l.minutes}分</span>}</div><h1>{l.title}</h1><p class="lead">{l.goal}</p></header><div class="container article-grid"><aside class="toc"><details open><summary>{l.status==='published'?'この講座の目次':'この講座の構成'}</summary><ol>{sectionNames.map((s,i)=><li><a href={`#${sectionIds[i]}`}>{s}</a></li>)}</ol></details><a class="toc-lab" href={url('simulator/')}>飛距離を試す ↗</a></aside><article class="prose" data-status={l.status}>
{l.status==='published' && Article ? <Article/> : <><div class="notice"><strong>本文は未公開です</strong><p>以下は制作予定の詳細アウトラインです。完成した解説・数式・図解・理解度チェックは、今後のフェーズで公開します。</p></div><h2>学習目標</h2><p>{l.goal}</p><h2>詳細アウトライン</h2>{sectionNames.map((s,i)=><section class="outline-section"><h3 id={sectionIds[i]}><span class="mono">{String(i+1).padStart(2,'0')}</span> {s}</h3><p>{l.outline[i]}</p></section>)}</>}
<nav class="lesson-pagination" aria-label="講座の前後移動">{prev?<a href={url(`learn/${prev.id}/`)}><small>← 前の講座 · {prev.status==='published'?'公開中':'本文未公開'}</small>{prev.title}</a>:<span/>}{next?<a href={url(`learn/${next.id}/`)}><small>次の講座 → · {next.status==='published'?'公開中':'本文未公開'}</small>{next.title}</a>:<span/>}</nav></article></div></Base>

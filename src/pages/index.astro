---
import Base from '../layouts/Base.astro';
import Diagram from '../components/Diagram.astro';
import LessonCard from '../components/LessonCard.astro';
import {chapters,publishedLessons} from '../data/curriculum';
import {url} from '../lib/paths';
---
<Base><section class="hero"><div class="container"><div class="hero-top"><span class="eyebrow light">FOOTBALL × PHYSICS</span><span class="hero-edition">THE LONG KICK ACADEMY / 01</span></div><div class="hero-grid"><div class="hero-copy"><p class="hero-kicker">中高生サッカー選手のための物理アカデミー</p><h1>その一蹴りに、<br/><em>理由</em>がある。</h1><p class="hero-description">なぜ飛ぶのか。どうすれば、もっと届くのか。<br/>助走からバウンドまで、物理の視点で<br class="desktop"/>ロングキックを読み解こう。</p><div class="hero-actions"><a class="button lime" href={url('learn/06-1/')}>飛行のしくみから学ぶ <span>↗</span></a><a class="text-link" href={url('chapters/')}>全講座を見る <span>→</span></a></div><div class="hero-stats"><div><strong>08</strong><span>チャプター</span></div><div><strong>24</strong><span>講座の学習設計</span></div><div><strong>{String(publishedLessons.length).padStart(2,'0')}</strong><span>公開中の講座</span></div></div></div><div class="hero-visual"><div class="diagram-label"><span class="status-dot"></span> FIELD NOTE 06 <span>飛行軌道と飛距離</span></div><Diagram dark/><div class="hero-equation"><span>IDEAL FLIGHT</span><strong>水平は一定。鉛直は加速。</strong><p>ひとつのキックを、ふたつの運動へ。</p></div></div></div></div></section>
<div class="concept-strip"><div class="container"><span>問いから始める</span><i>→</i><span>数式を導く</span><i>→</i><span>シミュレーションで試す</span><i>→</i><span>ピッチで確かめる</span></div></div>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">START WITH FLIGHT</span><h2>まずは、ボールの飛び方から。</h2><p>Chapter 06の3講座を公開中。基礎から発展へ、順に学べます。</p></div><a class="arrow-link" href={url('chapters/06/')}>Chapter 06へ <span>↗</span></a></div><div class="lesson-grid">{chapters[5].lessons.map(l=><LessonCard lesson={l}/>)}</div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">NEW · SPIN &amp; AERODYNAMICS</span><h2>回転が変える、ボールの行方。</h2><p>Chapter 07の3講座を追加。角力積からマグヌス力、三次元の飛行解析へ。</p></div><a class="arrow-link" href={url('chapters/07/')}>Chapter 07へ <span>↗</span></a></div><div class="lesson-grid">{chapters[6].lessons.map(l=><LessonCard lesson={l}/>)}</div></section>
<section class="container lab-banner"><div><span class="eyebrow">INTERACTIVE LAB</span><h2>角度を変えると、<br/>どこまで届く？</h2><p>初速度・角度・高さを動かして、軌道の変化を観察。<br/>予想してから、試してみよう。</p><a class="button dark-button" href={url('simulator/')}>飛距離シミュレーターを開く <span>↗</span></a></div><div class="lab-symbol" aria-hidden="true"><svg viewBox="0 0 340 180"><path d="M20 150Q150-80 320 150" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 150Q150 0 280 150M20 150H320" fill="none" stroke="currentColor" opacity=".35" stroke-dasharray="5 6"/><circle cx="170" cy="35" r="12" fill="#142b30"/></svg><span>MODEL 01 · 空気抵抗なし</span></div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">THE LEARNING MAP</span><h2>一蹴りを、8つの視点で。</h2><p>身体からボール、そして空気と地面へ。</p></div><a class="arrow-link" href={url('chapters/')}>24講座の学習マップ <span>↗</span></a></div><div class="chapter-grid">{chapters.map(c=><a class:list={['chapter-card',{featured:c.lessons.some(l=>l.status==='published')}]} href={url(`chapters/${c.id}/`)}><span class="chapter-number">{c.id}</span><span class="eyebrow">{c.label}</span><h3>{c.title}</h3><p>{c.description}</p><div class="card-end">{c.lessons.filter(l=>l.status==='published').length?`${c.lessons.filter(l=>l.status==='published').length}講座公開中`:'3講座・本文未公開'} <span>↗</span></div></a>)}</div></section>
<section class="principles section"><div class="container principle-grid"><div><span class="eyebrow">HOW WE THINK</span><h2>理屈を学び、<br/>自分のキックで確かめる。</h2></div><div><p>理論モデルは現実を考えるための道具です。実験で分かったこと、理論から言えること、これから確かめることを分けて学びます。</p><div class="tags"><span class="tag">理論モデル</span><span class="tag">実験的知見</span><span class="tag">技術的仮説</span></div><a class="arrow-link" href={url('about/')}>学び方と科学的な前提 <span>↗</span></a></div></div></section></Base>
